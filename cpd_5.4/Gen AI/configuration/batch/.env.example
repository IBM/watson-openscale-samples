# ---------------------------------------------------------------------------
# GenAI Batch End-to-End Monitoring — environment template
#
#   cp .env.example test.env     # then fill in the values below
#
# Both notebooks ("… (JDBC).ipynb" and "… (Object Storage).ipynb") call
# load_dotenv("test.env", override=False) in section 2-A, so the file must sit
# in THIS directory and be named test.env.  override=False means a variable
# already exported in your shell wins over the file.
#
# Every value here has an inline fallback in the notebook, so you only need
# the ones your flow actually uses: the "Common" + "Spark" blocks, plus EITHER
# the JDBC block OR the Object Storage block.
#
# test.env holds live credentials — keep it out of git (the repo .gitignore
# now covers *.env).
#
# Not configurable here: CONTEXT_FIELDS and QUESTION_FIELD are plain Python
# literals in notebook cell 2-F; edit them in the notebook.
# ---------------------------------------------------------------------------


# ─── Common: CPD credentials (both notebooks) ──────────────────────────────
# Required.  A placeholder left in <angle brackets> is rejected by
# validate_setup() in section 3, so the notebook stops before doing damage.
CPD_URL=https://cpd-cpd-instance.apps.example.cp.fyre.ibm.com
CPD_USERNAME=admin
CPD_PASSWORD=
# API key from CPD → Profile and settings → API key.  Used by the Spark
# curation job, which cannot reuse a username/password session.
CPD_APIKEY=

# Deployment space that will hold the Detached Prompt Template Asset.
# CPD → Deployments → Spaces → <your space> → Manage → Space GUID.
SPACE_ID=

# watsonx.governance service instance.  The all-zero UUID is the default
# single-instance ID on CPD and is correct unless your cluster was set up
# with a named instance.
SERVICE_INSTANCE_ID=00000000-0000-0000-0000-000000000000


# ─── Common: model and prompt metadata (both notebooks) ────────────────────
# Descriptive only — the model is external ("detached"), so nothing here is
# called.  The defaults below are a working example; change them to describe
# your own model.
MODEL_ID=google/flan-t5-xl
MODEL_NAME=flan-t5-xl
MODEL_PROVIDER=Hugging Face
MODEL_URL=https://huggingface.co/google/flan-t5-xl
PROMPT_URL=https://huggingface.co/google/flan-t5-xl

# Prompt template.  The {braced} names must match QUESTION_FIELD and
# CONTEXT_FIELDS in notebook cell 2-F.
PROMPT_INPUT={question} {context}

# DPTA display name.  Re-running a notebook reuses the asset with this name
# instead of creating a duplicate, so use a distinct name per notebook.
DPTA_NAME=External prompt sample for genAI batch JDBC

LABEL_COLUMN=ground_truth
# retrieval_augmented_generation | summarization | question_answering
TASK_ID=retrieval_augmented_generation


# ─── JDBC notebook only ────────────────────────────────────────────────────
# The DB2/PostgreSQL database that will hold the landing, curated and
# quarantine tables.  The schema must already exist and your user must be able
# to CREATE TABLE in it.
JDBC_DATABASE_NAME=SAMPLE
JDBC_SCHEMA_NAME=GENAI_BATCH

# DB2:        jdbc:db2://<host>:50001/<DBNAME>
# Do not add ":sslConnection=true;" to the URL. SSL is controlled by JDBC_USE_SSL.
# PostgreSQL: jdbc:postgresql://<host>:5432/<DBNAME>
# Without SSL (JDBC_USE_SSL=false), DB2: jdbc:db2://<host>:50000/<DBNAME>
JDBC_URL=jdbc:db2://db2host.example.com:50001/SAMPLE

# DB2: com.ibm.db2.jcc.DB2Driver   PostgreSQL: org.postgresql.Driver
JDBC_DB_DRIVER=com.ibm.db2.jcc.DB2Driver

# SSL is on by default.  Supply the base64-encoded server certificate in
# JDBC_CERT (base64 -i server.crt | tr -d '\n'); it can stay empty only when
# the certificate is signed by a public CA.  For a database without SSL set
# JDBC_USE_SSL=false and leave JDBC_CERT empty.
JDBC_USE_SSL=true
JDBC_CERT=

JDBC_USERNAME=db2inst1
JDBC_PASSWORD=


# ─── Object Storage notebook only ──────────────────────────────────────────
# Any S3-compatible store (IBM COS, MinIO, AWS S3, ...).  HMAC credentials,
# not an IAM API key.
OBJECT_STORAGE_BUCKET_NAME=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud


# ─── Spark: the curation engine (both notebooks) ───────────────────────────
# The watsonx.data Spark engine runs the scheduled curation job (landing ->
# curated, invalid rows -> quarantine).  The engine's applications URL is
# looked up from the lakehouse instance ID, so you don't set it.
LAKEHOUSE_INSTANCE_ID=
# Storage volume the Spark job mounts (CPD -> Storage volumes), as <instance>::<name>.
# Must NOT be the Spark engine's own home volume; setup validation lists the usable ones.
SPARK_VOLUME=
# Optional.  Leave empty to use the instance's only Spark engine.  Set it (e.g.
# spark362) only if the instance has more than one; otherwise discovery stops
# and lists the engine IDs to choose from.
SPARK_ENGINE_ID=


# ─── Optional: Integrated System display names ─────────────────────────────
# These names are the idempotency keys for find_or_create_integrated_system(),
# so a re-run reuses the existing system instead of creating a second one.
# Change them only if you want separately named systems — e.g. two people
# sharing one cluster.
JDBC_CONNECTION_NAME=JDBC_CONNECTION
JDBC_CONNECTION_DESCRIPTION=
OBJECT_STORAGE_CONNECTION_NAME=OBJECT_STORAGE_CONNECTION
OBJECT_STORAGE_CONNECTION_DESCRIPTION=
SPARK_ENGINE_NAME=Spark Engine - GenAI Batch
SPARK_ENGINE_DESCRIPTION=
SPARK_DISPLAY_NAME=WXD Spark - GenAI Batch
